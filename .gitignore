# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Registro del emulador de Firestore
firestore-debug.log
firebase-debug.log
ui-debug.log

# Dependencias del Worker
worker/node_modules
worker/.wrangler

# Ilustraciones originales de las tarjetas de producto.
# El sitio usa las versiones optimizadas de src/assets/productos (56 KB vs 5.4 MB).
# Se dejan fuera del repositorio para no cargar el historial con archivos que
# nadie compila; si hace falta re-exportarlas, estan en la maquina.
use/
